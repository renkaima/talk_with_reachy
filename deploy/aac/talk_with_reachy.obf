{
  "format": "open-board-0.1",
  "id": "talk_with_reachy",
  "locale": "en",
  "name": "Talk with Reachy",
  "description_html": "The words Reachy understands in the Day Center profile. Each button speaks a short phrase aloud for Reachy to hear. Row 1: requests. Row 2: answers to Reachy's questions. Row 3: break activities.",
